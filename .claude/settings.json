{
  "permissions": {
    "allow": [
      "Bash(node tools/*)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(npm install)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse*)",
      "Bash(curl -s*)",
      "Bash(jq *)",
      "WebFetch(domain:itch.io)",
      "WebFetch(domain:img.itch.zone)",
      "WebFetch(domain:store.steampowered.com)",
      "WebFetch(domain:steamcommunity.com)",
      "WebFetch(domain:store.fastly.steamstatic.com)",
      "WebFetch(domain:shared.fastly.steamstatic.com)",
      "WebFetch(domain:community.fastly.steamstatic.com)",
      "WebFetch(domain:images.steamusercontent.com)",
      "WebSearch",
      "Bash(tools/hurdles-cloud.sh *)",
      "Bash(tools/cloud-setup.sh*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hurdles-cloud.sh hook-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hurdles-cloud.sh hook-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hurdles-cloud.sh hook-end",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
